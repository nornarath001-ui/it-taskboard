FROM php:8.3-fpm-alpine

RUN apk add --no-cache nginx curl libpng-dev libzip-dev zip unzip nodejs npm \
    && docker-php-ext-install pdo_mysql bcmath gd zip opcache

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /var/www/html

# PHP packages (cached while composer files do not change)
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-progress --no-scripts --prefer-dist

# App code, then the Tailwind CSS / SweetAlert build
COPY . .
RUN composer dump-autoload --no-dev --optimize \
    && npm install && npm run build && rm -rf node_modules

# Web server and PHP settings
COPY deploy/nginx.conf /etc/nginx/http.d/default.conf
COPY deploy/php.ini /usr/local/etc/php/conf.d/local.ini

# PHP (www-data) must be able to write here
RUN mkdir -p /run/nginx storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

# Sessions and cache live in the external MySQL database
ENV APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    SESSION_DRIVER=database \
    CACHE_STORE=database \
    QUEUE_CONNECTION=sync

EXPOSE 80
CMD ["sh", "-c", "sed -i \"s/listen 80;/listen ${PORT:-80};/\" /etc/nginx/http.d/default.conf && php-fpm -D && exec nginx -g 'daemon off;'"]
