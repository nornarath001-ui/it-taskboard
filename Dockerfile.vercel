# 1) PHP packages
FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-progress --no-scripts --prefer-dist

# 2) Tailwind CSS / SweetAlert build (Node stays out of the final image)
FROM node:22-alpine AS assets
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
COPY --from=vendor /app/vendor ./vendor
RUN npm run build

# 3) Final image: PHP-FPM + nginx only
FROM php:8.3-fpm-alpine

RUN apk add --no-cache nginx libpng-dev libzip-dev \
    && docker-php-ext-install pdo_mysql bcmath gd zip opcache

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html
COPY . .
COPY --from=vendor /app/vendor ./vendor
COPY --from=assets /app/public/build ./public/build

COPY deploy/nginx.conf /etc/nginx/http.d/default.conf
COPY deploy/php.ini /usr/local/etc/php/conf.d/zz-app.ini

# Precompile views and routes now, so the first request is not slow
RUN mkdir -p /run/nginx storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && composer dump-autoload --no-dev --classmap-authoritative \
    && php artisan view:cache \
    && php artisan route:cache \
    && rm /usr/bin/composer \
    && chown -R www-data:www-data storage bootstrap/cache

ENV APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    SESSION_DRIVER=cookie \
    CACHE_STORE=database \
    QUEUE_CONNECTION=sync

EXPOSE 80
CMD ["sh", "-c", "sed -i \"s/listen 80;/listen ${PORT:-80};/\" /etc/nginx/http.d/default.conf && php-fpm -D && exec nginx -g 'daemon off;'"]
